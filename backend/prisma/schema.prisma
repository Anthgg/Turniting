generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  email     String     @unique
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  documents Document[]
}

model Document {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String?          @db.Uuid
  originalName   String
  mimeType       String
  size           Int
  status         DocumentStatus   @default(UPLOADED)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  currentVersion DocumentVersion?
  analyses       Analysis[]

  @@index([userId])
  @@index([status])
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  OCR_REQUIRED
  FAILED
}

model DocumentVersion {
  id                   String            @id @default(uuid()) @db.Uuid
  documentId           String            @unique @db.Uuid
  storageKey           String            @unique
  fileHash             String            @db.Char(64)
  extractedText        String?           @db.Text
  extractionError      String?           @db.Text
  pageCount            Int?
  wordCount            Int?
  characterCount       Int?
  requiresOcr          Boolean           @default(false)
  ocrStatus            OcrStatus         @default(NOT_NEEDED)
  averageOcrConfidence Float?
  warnings             String[]          @default([])
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(6)
  document             Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pages                DocumentPage[]
  ocrRuns              OcrRun[]
  turnitinReports      TurnitinReport[]
  groundTruthCases     GroundTruthCase[]
  trainingSamples      TrainingSample[]
}

enum OcrStatus {
  NOT_NEEDED
  REQUIRED
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum ExtractionMethod {
  DIGITAL
  OCR
  HYBRID
  NONE
}

enum OcrRunStatus {
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

model DocumentPage {
  id                    String           @id @default(uuid()) @db.Uuid
  documentVersionId     String           @db.Uuid
  pageNumber            Int
  width                 Float
  height                Float
  rotation              Int              @default(0)
  extractionMethod      ExtractionMethod @default(NONE)
  digitalText           String?          @db.Text
  ocrText               String?          @db.Text
  canonicalText         String           @default("") @db.Text
  requiresOcr           Boolean          @default(false)
  ocrConfidence         Float?
  ocrBlockCount         Int?
  ocrLowConfidenceCount Int?
  ocrMetadata           Json?
  createdAt             DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(6)
  documentVersion       DocumentVersion  @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@unique([documentVersionId, pageNumber])
  @@index([documentVersionId, pageNumber])
}

model OcrRun {
  id                String          @id @default(uuid()) @db.Uuid
  documentVersionId String          @db.Uuid
  engine            String
  engineVersion     String
  model             String
  language          String
  pipelineVersion   String
  status            OcrRunStatus    @default(PROCESSING)
  pagesRequested    Int             @default(0)
  pagesProcessed    Int             @default(0)
  pagesSkipped      Int             @default(0)
  pagesFailed       Int             @default(0)
  averageConfidence Float?
  durationMs        Int?
  config            Json?
  warningCount      Int             @default(0)
  errorCode         String?
  errorMessage      String?         @db.Text
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([documentVersionId, createdAt])
  @@index([status, createdAt])
}

model Analysis {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @db.Uuid
  status       String   @default("pending")
  aiScore      Float?
  confidence   Float?
  modelVersion String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([status])
}

enum TurnitinReportType {
  AI_WRITING
  SIMILARITY
  UNKNOWN
}

enum TurnitinReportStatus {
  UPLOADED
  PROCESSING
  PARSED
  PARTIAL
  FAILED
  OCR_REQUIRED
}

enum TurnitinSourceType {
  INTERNET
  PUBLICATION
  STUDENT_PAPER
  OTHER
}

enum TurnitinSegmentType {
  AI_FLAGGED
  SIMILARITY_MATCH
  NOT_FLAGGED
  UNKNOWN
}

enum TurnitinMatchStatus {
  UNVERIFIED
  EXACT
  HIGH
  PARTIAL
  MISMATCH
}

enum TurnitinSubmissionRelation {
  UNKNOWN
  SAME
  DIFFERENT
}

enum GroundTruthCaseType {
  AI_REPORT
  SIMILARITY_REPORT
  VALIDATION
}

model TurnitinReport {
  id                         String                     @id @default(uuid()) @db.Uuid
  originalName               String
  mimeType                   String                     @default("application/pdf")
  size                       Int
  fileHash                   String                     @db.Char(64)
  storageKey                 String                     @unique
  reportType                 TurnitinReportType         @default(UNKNOWN)
  status                     TurnitinReportStatus       @default(UPLOADED)
  requiresOcr                Boolean                    @default(false)
  parserVersion              String?
  submissionId               String?
  submissionFileName         String?
  submittedAt                DateTime?                  @db.Timestamptz(6)
  downloadedAt               DateTime?                  @db.Timestamptz(6)
  reportPageCount            Int?
  documentPageCount          Int?
  wordCount                  Int?
  characterCount             Int?
  aiWritingScore             Float?
  aiWritingScoreRaw          String?
  similarityScore            Float?
  similarityScoreRaw         String?
  internetScore              Float?
  internetScoreRaw           String?
  publicationScore           Float?
  publicationScoreRaw        String?
  studentPapersScore         Float?
  studentPapersScoreRaw      String?
  filters                    String[]                   @default([])
  warnings                   String[]                   @default([])
  reportMetadata             Json?
  documentVersionId          String?                    @db.Uuid
  contentMatchStatus         TurnitinMatchStatus        @default(UNVERIFIED)
  submissionRelation         TurnitinSubmissionRelation @default(UNKNOWN)
  contentSimilarityRatio     Float?
  contentMatchEvidence       Json?
  matchedAt                  DateTime?                  @db.Timestamptz(6)
  alignmentVersion           String?
  alignmentEngine            String?
  alignmentStale             Boolean                    @default(false)
  createdAt                  DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                   @updatedAt @db.Timestamptz(6)
  documentVersion            DocumentVersion?           @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  sources                    TurnitinSource[]
  segments                   TurnitinSegment[]
  aiGroundTruthCases         GroundTruthCase[]          @relation("GroundTruthAIReport")
  similarityGroundTruthCases GroundTruthCase[]          @relation("GroundTruthSimilarityReport")

  @@index([reportType, createdAt])
  @@index([status, createdAt])
  @@index([documentVersionId])
}

model TurnitinSource {
  id                   String             @id @default(uuid()) @db.Uuid
  reportId             String             @db.Uuid
  sourceIndex          Int
  sourceType           TurnitinSourceType @default(OTHER)
  displayName          String
  percentageRaw        String?
  percentage           Float?
  percentageIsLessThan Boolean            @default(false)
  color                String?
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  report               TurnitinReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  segments             TurnitinSegment[]

  @@unique([reportId, sourceIndex])
  @@index([reportId, sourceType])
}

model TurnitinSegment {
  id                  String              @id @default(uuid()) @db.Uuid
  reportId            String              @db.Uuid
  sourceId            String?             @db.Uuid
  segmentIndex        Int
  segmentType         TurnitinSegmentType
  pageNumber          Int
  text                String              @db.Text
  normalizedText      String?             @db.Text
  bbox                Json
  sourceIndex         Int?
  color               String?
  documentStartOffset Int?
  documentEndOffset   Int?
  alignmentMethod     String?
  alignmentScore      Float?
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  report              TurnitinReport      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  source              TurnitinSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  trainingSamples     TrainingSample[]

  @@unique([reportId, segmentIndex])
  @@index([reportId, segmentType, segmentIndex])
  @@index([sourceId])
}

model GroundTruthCase {
  id                 String                     @id @default(uuid()) @db.Uuid
  name               String                     @unique
  caseType           GroundTruthCaseType
  aiReportId         String?                    @db.Uuid
  similarityReportId String?                    @db.Uuid
  documentVersionId  String?                    @db.Uuid
  submissionRelation TurnitinSubmissionRelation @default(UNKNOWN)
  contentMatchStatus TurnitinMatchStatus        @default(UNVERIFIED)
  validationStatus   TurnitinMatchStatus        @default(UNVERIFIED)
  expectedData       Json?
  actualData         Json?
  notes              String?                    @db.Text
  createdAt          DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(6)
  aiReport           TurnitinReport?            @relation("GroundTruthAIReport", fields: [aiReportId], references: [id], onDelete: Restrict)
  similarityReport   TurnitinReport?            @relation("GroundTruthSimilarityReport", fields: [similarityReportId], references: [id], onDelete: Restrict)
  documentVersion    DocumentVersion?           @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  trainingSamples    TrainingSample[]

  @@index([caseType, createdAt])
  @@index([documentVersionId])
}

// ---------------------------------------------------------------- F004 dataset formalization
// Massive public datasets stay in Parquet files under training/. The database keeps versions,
// provenance, licences, statistics, artifacts, split manifests, model metadata and the small
// set of locally derived training samples.

enum DatasetStatus {
  DRAFT
  BUILDING
  READY
  INVALID
  ARCHIVED
}

enum DatasetSourceStatus {
  INCLUDED
  BLOCKED_ACCESS
  EXCLUDED_LICENSE
  CONSIDERED
}

enum DatasetSourceType {
  HUGGINGFACE
  ZENODO
  GITHUB
  LOCAL
  TURNITIN
  OTHER
}

enum LicenseStatus {
  ALLOWED
  NON_COMMERCIAL_ONLY
  UNDECLARED
  RESTRICTED
  UNKNOWN
  BLOCKED
}

enum CommercialUseStatus {
  ALLOWED
  NOT_ALLOWED
  UNCLEAR
}

enum DatasetArtifactType {
  MANIFEST
  LICENSE_AUDIT
  STATISTICS
  SPLIT_MANIFEST
  PARQUET_SHARD
  TRAINING_REPORT
  EVALUATION_REPORT
  CONFIG
  MODEL_WEIGHTS
}

enum StorageProvider {
  REPOSITORY
  LOCAL
  GOOGLE_DRIVE
}

enum DatasetSplit {
  TRAIN
  VALIDATION
  TEST
  OOD
  ADVERSARIAL_TEST
  ADVERSARIAL_VALIDATION
  UNSEEN_GENERATOR_TEST
  UNSEEN_DOMAIN_TEST
  MIXED
  UNKNOWN
}

enum TrainingLabel {
  HUMAN
  MACHINE
  MIXED
  UNKNOWN
}

enum LabelSource {
  PUBLIC_DATASET
  TURNITIN_AI_FLAGGED
  MANUAL
  SYNTHETIC
  DERIVED
  UNKNOWN
}

enum PrivacyClass {
  PUBLIC
  PRIVATE
  SYNTHETIC
}

enum ModelStatus {
  EXPERIMENTAL
  CANDIDATE
  ACTIVE
  RETIRED
  INVALID
}

enum ModelType {
  BASELINE
  TRANSFORMER
  ENSEMBLE
}

enum CommercialEligibility {
  RESEARCH_ONLY
  COMMERCIAL_ALLOWED
  UNKNOWN
}

model DatasetVersion {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String
  version                String
  status                 DatasetStatus           @default(DRAFT)
  description            String?                 @db.Text
  schemaVersion          Int                     @default(1)
  createdFromGitCommit   String?
  totalRows              Int?
  humanRows              Int?
  machineRows            Int?
  mixedRows              Int?
  spanishRows            Int?
  academicRows           Int?
  languageCount          Int?
  domainCount            Int?
  generatorCount         Int?
  exactDuplicatesRemoved Int?
  nearDuplicatesRemoved  Int?
  labelConflicts         Int?
  leakageStatus          String?
  manifestPath           String?
  statisticsPath         String?
  metadata               Json?
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  sources                DatasetSource[]
  artifacts              DatasetArtifact[]
  splitManifests         TrainingSplitManifest[]
  samples                TrainingSample[]
  modelVersions          ModelVersion[]

  @@unique([name, version])
  @@index([status, createdAt])
}

model DatasetSource {
  id                  String              @id @default(uuid()) @db.Uuid
  datasetVersionId    String              @db.Uuid
  name                String
  status              DatasetSourceStatus @default(INCLUDED)
  sourceUrl           String?
  sourceType          DatasetSourceType   @default(OTHER)
  license             String?
  licenseStatus       LicenseStatus       @default(UNKNOWN)
  commercialUseStatus CommercialUseStatus @default(UNCLEAR)
  rowsAvailable       Int?
  rowsUsed            Int?
  spanishRows         Int?
  academicRows        Int?
  samplingWeight      Float?
  sha256              String?
  metadata            Json?
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  datasetVersion      DatasetVersion      @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  samples             TrainingSample[]

  @@unique([datasetVersionId, name])
  @@index([datasetVersionId, licenseStatus])
}

model DatasetArtifact {
  id               String              @id @default(uuid()) @db.Uuid
  datasetVersionId String?             @db.Uuid
  modelVersionId   String?             @db.Uuid
  artifactType     DatasetArtifactType
  storageProvider  StorageProvider     @default(REPOSITORY)
  path             String
  sha256           String?             @db.Char(64)
  sizeBytes        BigInt?
  external         Boolean             @default(false)
  metadata         Json?
  createdAt        DateTime            @default(now()) @db.Timestamptz(6)
  datasetVersion   DatasetVersion?     @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  modelVersion     ModelVersion?       @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, artifactType, path])
  @@index([modelVersionId])
}

model TrainingSplitManifest {
  id               String         @id @default(uuid()) @db.Uuid
  datasetVersionId String         @db.Uuid
  split            DatasetSplit
  rowCount         Int
  groupCount       Int?
  manifestPath     String?
  sha256           String?        @db.Char(64)
  metadata         Json?
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  datasetVersion   DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, split])
}

model TrainingSample {
  id                  String           @id @default(uuid()) @db.Uuid
  datasetVersionId    String?          @db.Uuid
  datasetSourceId     String?          @db.Uuid
  documentVersionId   String?          @db.Uuid
  turnitinSegmentId   String?          @db.Uuid
  groundTruthCaseId   String?          @db.Uuid
  externalSampleId    String?
  text                String?          @db.Text
  textHash            String           @db.Char(64)
  label               TrainingLabel    @default(UNKNOWN)
  labelSource         LabelSource      @default(UNKNOWN)
  language            String?
  domain              String?
  generator           String?
  split               DatasetSplit?
  eligibleForTraining Boolean          @default(false)
  confidence          Float?
  privacyClass        PrivacyClass     @default(PRIVATE)
  metadata            Json?
  createdAt           DateTime         @default(now()) @db.Timestamptz(6)
  datasetVersion      DatasetVersion?  @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  datasetSource       DatasetSource?   @relation(fields: [datasetSourceId], references: [id], onDelete: SetNull)
  documentVersion     DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  turnitinSegment     TurnitinSegment? @relation(fields: [turnitinSegmentId], references: [id], onDelete: SetNull)
  groundTruthCase     GroundTruthCase? @relation(fields: [groundTruthCaseId], references: [id], onDelete: SetNull)

  @@unique([datasetVersionId, turnitinSegmentId])
  @@index([datasetVersionId, label, split])
  @@index([groundTruthCaseId])
  @@index([textHash])
}

model ModelVersion {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String                @unique
  architecture          String
  variant               String?
  datasetVersionId      String?               @db.Uuid
  status                ModelStatus           @default(EXPERIMENTAL)
  modelType             ModelType
  trainingEnvironment   String?
  commercialEligibility CommercialEligibility @default(UNKNOWN)
  artifactProvider      StorageProvider?
  artifactPath          String?
  gitCommit             String?
  metrics               Json
  thresholds            Json?
  calibration           Json?
  limitations           String[]              @default([])
  metadata              Json?
  createdAt             DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(6)
  datasetVersion        DatasetVersion?       @relation(fields: [datasetVersionId], references: [id], onDelete: SetNull)
  artifacts             DatasetArtifact[]

  @@index([status, createdAt])
  @@index([datasetVersionId])
}
