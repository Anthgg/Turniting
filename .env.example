# Local development values for Compose and host-run services. Set a random password before startup.
POSTGRES_DB=turniting
POSTGRES_USER=turniting
POSTGRES_PASSWORD=replace-with-a-random-local-password

# Local NestJS process values. Docker Compose injects its container-specific URLs.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://turniting:replace-with-a-random-local-password@localhost:5432/turniting?schema=public
DIRECT_URL=postgresql://turniting:replace-with-a-random-local-password@localhost:5432/turniting?schema=public
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000
AI_OCR_TIMEOUT_MS=180000

# Document ingestion. Compose mounts persistent storage at /data/uploads.
MAX_UPLOAD_MB=20
MAX_TURNITIN_REPORT_MB=30
# F009.0: use the OS temp directory locally; Compose sets /data/reports on its named volume.
REPORT_STORAGE_ROOT=
REPORT_RETENTION_HOURS=24
# F004: read-only training manifests/reports (metadata only; no datasets or weights)
TRAINING_DIR=/app/training
UPLOAD_DIR=/data/uploads
OCR_MIN_CHARS_PER_PAGE=20
OCR_MIN_LOW_TEXT_PAGE_RATIO=0.5
OCR_ENGINE=paddleocr
OCR_ENGINE_VERSION=3.7.0
OCR_LANGUAGE=es
OCR_MODEL=PP-OCRv5_mobile_det+latin_PP-OCRv5_mobile_rec
OCR_MODEL_DIR=/data/models/paddleocr
OCR_PIPELINE_VERSION=f003-v1
OCR_DPI=220
OCR_CPU_THREADS=2
OCR_TIMEOUT_MS=120000
OCR_MAX_PAGES_PER_RUN=150
OCR_MAX_RENDER_PIXELS=20000000
OCR_LOW_CONFIDENCE_THRESHOLD=0.60
OCR_MAX_CONCURRENT_JOBS=1
OCR_MIN_DIGITAL_CHARS=20
OCR_MIN_DIGITAL_WORDS=4
OCR_IMAGE_AREA_RATIO=0.15
OCR_BLANK_PAGE_THRESHOLD=0.004
OCR_DESKEW_MIN_ANGLE=1.0
OCR_CONTRAST_RANGE=70

# F005 local AI analyzer. Server-side artifact paths (host-run ai-service); Docker uses
# /data/models/local/* mounted from ./data/models. Import weights with
# python scripts/import_model_artifact.py --model CANDIDATE_MODEL_V3 --source <dir>
AI_MODEL_V2_PATH=./data/models/candidate-v2
AI_MODEL_V3_PATH=./data/models/candidate-v3
AI_BASELINE_MODEL_PATH=./data/models/baseline
AI_MODEL_DEVICE=auto
MODEL_MAX_RESIDENT=1
MODEL_MAX_JOBS=1
AI_MODEL_CPU_THREADS=4
MIN_PARAGRAPH_CHARS=120
MIN_PARAGRAPH_WORDS=20
MIN_PARAGRAPH_TOKENS=32
AI_ANALYSIS_TIMEOUT_MS=600000

CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# Empty means same-origin /api; Vite proxies it in development and Nginx in Docker.
VITE_API_URL=
PYTHON_ENV=development
